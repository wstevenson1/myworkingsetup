# ~/.bashrc
# User-level bash configuration loaded by login and interactive shells.

# Local paths.
export PATH="$HOME/.local/bin:$HOME/.programs:$PATH"

# Linuxbrew / Homebrew. brew is not on PATH yet, so probe the known install
# locations directly -- the Linux installer always uses /home/linuxbrew.
for __brew in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew" \
              /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$__brew" ]; then
    eval "$("$__brew" shellenv)"
    break
  fi
done
unset __brew

# Bash completion.
if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

# Aliases and helper functions.
if [ -f "$HOME/.aliases" ]; then
  . "$HOME/.aliases"
fi

# Bash history improvements.
export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
PROMPT_COMMAND='history -a; history -n'
export HISTIGNORE='&:[ ]*'

# zoxide: `cd` becomes the zoxide jump command (zoxide init --cmd cd).
# Must be initialized BEFORE bash-preexec. zoxide appends __zoxide_hook to
# PROMPT_COMMAND, and doing that after bash-preexec has installed its trap
# breaks the preexec/precmd chain the sqlite history logger depends on.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
fi

# Optional bash-preexec helper.
if [ -f "$HOME/.bash-preexec.sh" ]; then
  . "$HOME/.bash-preexec.sh"
fi

# Command history to SQLite (~/.hist.db). Must be sourced last: it installs
# preexec/precmd hooks, and anything that rewrites PROMPT_COMMAND afterwards
# clobbers them.
HISTDB="${HOME}/.hist.db"
if [ -r "${HOME}/.bash-history-sqlite.sh" ]; then
  . "${HOME}/.bash-history-sqlite.sh"
fi
