# .zshrc
#
# Portable zsh rc, deployed by roles/zsh/. This is a hand-portable rewrite of
# the Mac ~/.zshrc, the same way files/bashrc is a rewrite of the Mac ~/.bashrc:
# every macOS-only path, personal env var and absolute tool path is stripped,
# and every tool init is guarded so a host without that tool stays quiet.
# Feature-for-feature it mirrors files/bashrc, translated to zsh idiom.
#
# zsh sources this for interactive login and non-login shells alike and there
# is no separate ~/.zprofile / ~/.zshenv deployed, so PATH and everything else
# is built here.

# Non-interactive shells (e.g. `ssh host "command"`) need none of this. zsh
# normally does not read ~/.zshrc for those, but a forced source still bails.
case $- in
    *i*) ;;
      *) return ;;
esac

# ==============================================================================
# Oh My Zsh (optional)
# ==============================================================================
# Nothing below depends on OMZ. If you install it yourself into ~/.oh-my-zsh it
# is picked up here; otherwise this is a no-op. zsh-autosuggestions is vendored
# and sourced directly further down, so it works with or without OMZ.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
zstyle ':omz:update' mode disabled
plugins=(git fzf zsh-autosuggestions)
[ -r "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ==============================================================================
# Environment
# ==============================================================================
# TERM: let the terminal / multiplexer announce itself; only supply a value
# when one is missing entirely (ssh without pty, container exec, unset by a
# parent). Never override a real TERM. `dumb` is left alone unless something
# interactive clearly wants cursor addressing. See files/bashrc for the long
# form of this reasoning.
case "${TERM:-}" in
    ''|unknown)
        export TERM=xterm-256color
        ;;
    dumb)
        if [ -t 1 ] && [ -z "${INSIDE_EMACS:-}" ]; then
            export TERM=xterm-256color
        fi
        ;;
esac

export NO_COLOR=true
export EDITOR="$(command -v vim)"
export INPUTRC="$HOME/.inputrc"
export GPG_TTY="$(tty)"

export GOPATH="$HOME/.go"
export GOPROXY=direct
export GOSUMDB=off

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

unset SSH_AGENT_PID

# Quiet zoxide's init-order doctor check (zoxide is initialized near the end).
export _ZO_DOCTOR=0

# ==============================================================================
# PATH  (portable block, shared verbatim with files/bashrc)
# ==============================================================================
export PATH="$PATH:$GOPATH/bin:$HOME/.cargo/bin"
[ -d "$HOME/.programs" ] && export PATH="$HOME/.programs:$PATH"
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# Homebrew / Linuxbrew. brew is not on PATH yet, so probe the known install
# locations directly -- the Linux installer always uses /home/linuxbrew
# regardless of the prefix it is asked for. This must run before the
# `command -v` checks further down (zoxide, fzf, mise, fasd, broot), which
# otherwise cannot see any brew-installed tool.
for __brew in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew" \
              /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$__brew" ]; then
    eval "$("$__brew" shellenv)"
    break
  fi
done
unset __brew

# ==============================================================================
# History  (readline history; the SQLite DB is wired up further down)
# ==============================================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=500000
SAVEHIST=5000000
setopt EXTENDED_HISTORY SHARE_HISTORY INC_APPEND_HISTORY \
       HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ==============================================================================
# Prompt helper
# ==============================================================================
prompt() {
    case "$1" in
        on)  PROMPT='[%*][%n@%m:%~]%# ' ;;
        off) PROMPT='$ ' ;;
    esac
}

# ==============================================================================
# Functions  (the portable set from files/bashrc, in zsh idiom)
# ==============================================================================
buf() {
    local f=${1%%.*} e=${1/$f/}
    cp -v "$1" "$f-$(date +"%Y%m%d_%H%M%S")$e"
}

checkip() {
    ipcalc -c "$1" > /tmp/1
    grep INVALID /tmp/1 > /dev/null && echo "$1 is INVALID" || echo "$1 is VALID"
}

dir() { ~/.programs/directory_history.sh "$@" && cd "$(cat "$HOME/.cdargsresult")"; }

forloop() { for i in "${@:2}"; do echo "=== $i ==="; "$1" "$i"; done; }

# fuzzy-search the SQLite history db
h() {
    if [ -z "$1" ]; then
        dbhist | tail -38
    else
        sqlite3 "$HISTDB" "select * from command" | perl -F'\|' -lane '{ print $F[2] }' | grep -Ei "$@"
    fi
}

hl()  { hostlist -e -s" " "${@:1}"; }
hls() { hostlist -e -s, "${@:1}"; }
hlc() { hostlist -e -s: "${@:1}"; }
hln() { hostlist -e -i "${@:1}"; }

i() { uname -a; }

log() {
    local tmstamp hostname time_str id prompt_str
    mkdir -p ~/.logs
    tmstamp=$(date "+%m%d%Y%H%M%S")
    hostname=$(hostname)
    time_str=$(date "+%H:%M:%S")
    id=$(whoami)
    prompt_str="[$time_str][$id@$hostname:$PWD]$ $*"
    ( echo "$prompt_str"; "$@" 2>&1 ) | tee ~/.logs/log.$tmstamp.txt
    echo
    echo "Output is in ~/.logs/log.$tmstamp.txt"
}

mutt() { TERM=vt100 /usr/bin/mutt "$@"; }

n() {
    /usr/local/bin/nnn "$@"
    if [ -f "$NNN_TMPFILE" ]; then
        local nnn_dir
        nnn_dir="$(cat "$NNN_TMPFILE")"
        rm -f "$NNN_TMPFILE"
        if [ -d "$nnn_dir" ]; then
            builtin cd "$nnn_dir"
            command -v zoxide >/dev/null 2>&1 && zoxide add "$nnn_dir"
        fi
    fi
}

ping() { command ping "$@" 2>/dev/null | grep -v Unreac; }

sch() { for i in "${@:2}"; do echo "=== $i ==="; scp "$1" "$i:."; done; }

search() { sqlite3 "$HISTDB" "select * from command" | cut -c1-170 | grep -i "$@"; }

sm() { ~/.programs/ssh-multi "$@"; }

ssh() {
    local timestamp
    timestamp=$(date +%m-%d-%Y.%H:%M:%S)
    command ssh "$@" | tee -a ~/.logs/ssh."${1##*@}.$timestamp"
}

ss() { /usr/local/bin/fab --disable-known-hosts --skip-bad-hosts -a -k -H "$(echo "${@:1}" | hls -)" ss; }

sshloop() { for i in "${@:2}"; do echo "=== $i ==="; ssh "$i" "$1"; done; }

sxh() { for i in "${@:2}"; do echo "=== $i ==="; ssh "$i" "$1"; done; }

y() {
    local tmp
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# tmux mouse helpers (tmux 2.1+ single 'mouse' option)
tmux_mouse_enable()  { tmux set -g mouse on;  tmux display 'Mouse: ON'; }
tmux_mouse_disable() { tmux set -g mouse off; tmux display 'Mouse: OFF'; }
tmux_mouse_status()  {
    local s
    s=$(tmux show -gv mouse 2>/dev/null)
    echo "Mouse: ${(U)s}"
    tmux display "Mouse: ${(U)s}"
}
tmux_mouse_toggle() {
    if [ "$(tmux show -gv mouse 2>/dev/null)" = "off" ]; then
        tmux_mouse_enable
    else
        tmux_mouse_disable
    fi
}

# ==============================================================================
# Aliases
# ==============================================================================
[ -f ~/.aliases ] && source ~/.aliases

alias a='fasd -a'
alias aws='/usr/local/bin/aws'
alias c='clear'
alias cfzf="cd \$(fasd -d | perl -lane 'print \$F[-1]' | fzf)"
alias f='fasd -f'
alias ff='fasd -sif'
alias fkill='kill -9 $(ps ax -o pid,comm,ruser,args | fzf --multi --height 40% | awk '\''{print $1}'\'')'
alias grep='grep --color=auto'
alias k='kubectl'
alias locate='lolcate'
alias pc='$HOME/.programs/check_port.pl $@'
alias pfzf="find . -type f | fzf --preview 'cat {}'"
alias s='fasd -si'
alias updatedb='sudo lolcate --update'
alias vfzf="vi \$(find . -type f | fzf --height 60% -m)"
alias z='fasd_cd -d'
alias zz='fasd_cd -d -i'

# ==============================================================================
# Tool Initialization  (zsh equivalents of the files/bashrc block; all guarded)
# ==============================================================================
# fasd
if command -v fasd >/dev/null 2>&1; then
    fasd_cache="$HOME/.fasd-init-zsh"
    if [ "$(command -v fasd)" -nt "$fasd_cache" -o ! -s "$fasd_cache" ]; then
        fasd --init posix-alias zsh-hook zsh-ccomp zsh-ccomp-install \
             zsh-wcomp zsh-wcomp-install >| "$fasd_cache"
    fi
    source "$fasd_cache"
    unset fasd_cache
fi
# fasd's posix-alias init defines `d`; drop it so the recentdirs `d` function
# defined below is reachable.
unalias d 2>/dev/null

# logr: logger(1) wrapper (zsh port of ~/.logr.bash), deployed by roles/zsh/
[ -f "$HOME/.logr.zsh" ] && source "$HOME/.logr.zsh"

# dirtrack: directory-visit tracker; the init script has a native zsh branch
# (add-zsh-hook chpwd). Not deployed by this repo -- sourced only if present.
[ -f "$HOME/.dirtrack/dirtrack_init.sh" ] && source "$HOME/.dirtrack/dirtrack_init.sh"

# marker: guarded no-op unless/until marker is installed at this path
[[ -s "$HOME/.local/share/marker/marker.sh" ]] && source "$HOME/.local/share/marker/marker.sh"

# pyenv (only if present; mise generally supersedes this)
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init -)"
fi

# cargo / uv
[ -f "$HOME/.cargo/env" ]     && . "$HOME/.cargo/env"
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# tbmk key-bindings (zsh variant)
[ -f "$HOME/.tbmk/.zsh" ] && source "$HOME/.tbmk/.zsh"

# broot (the bash launcher's `br` function is zsh-compatible)
[ -f "$HOME/.config/broot/launcher/bash/br" ] && source "$HOME/.config/broot/launcher/bash/br"

# zxcv completions
command -v zxcv >/dev/null 2>&1 && source <(zxcv completion zsh) 2>/dev/null

export RECENT_DIRS_FILE="$HOME/.local/share/mytool/dirs"

# zsh-autosuggestions (vendored, deployed by roles/zsh/)
[ -r "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"

# mise -- must come before zoxide so zoxide's `cd` wins. Unlike bash, mise's
# zsh activation does not wrap `cd`, so no re-override hack is needed here.
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# zoxide provides the smart `cd`
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# fzf key bindings + completion (Ctrl-T, Alt-C, and its own Ctrl-R -- the
# latter is reassigned to Esc-Ctrl-R just below)
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

export FZF_DEFAULT_OPTS="--pointer='>' --color=bg+:#262626,bg:-1,fg:-1,fg+:#ffffff,hl:#5f87af,hl+:#5fd7ff,info:#afaf87,prompt:#d7005f,pointer:#ffffff,marker:#87ff00,spinner:#af5fff,header:#87afaf"

# SQLite history database (writes ~/.hist.db via native zsh preexec/precmd),
# deployed by roles/zsh/
export HISTDB="$HOME/.hist.db"
[ -f "$HOME/.zsh-history-sqlite.zsh" ] && source "$HOME/.zsh-history-sqlite.zsh"

# ==============================================================================
# Key bindings (zle widgets)
# ==============================================================================
# Ctrl-R: fuzzy-search the full ~/.hist.db (all panes, deduped). Esc-Ctrl-R
# keeps fzf's session-local history search.
__fzf_dbhistory() {
    local selected
    selected=$(sqlite3 -separator $'\t' "$HISTDB" \
        "SELECT command_id, command FROM command ORDER BY command_id DESC;" \
        | awk -F'\t' '!seen[$2]++' \
        | fzf --scheme=history --delimiter=$'\t' --with-nth=2 \
        | cut -f2-)
    if [[ -n "$selected" ]]; then
        BUFFER="$selected"
        CURSOR=${#BUFFER}
    fi
    zle reset-prompt
}
zle -N __fzf_dbhistory
bindkey '^R'   __fzf_dbhistory
bindkey '^[^R' fzf-history-widget

# Ctrl-F: pick a favourite command
__favs_widget() {
    local selected
    selected=$(favs 2>/dev/null)
    if [[ -n "$selected" ]]; then
        BUFFER="$selected"
        CURSOR=${#BUFFER}
    fi
    zle reset-prompt
}
zle -N __favs_widget
bindkey '^F' __favs_widget

# ==============================================================================
# recentdirs (~/code/recentdirs). The playbook installs the binary per-user
# into ~/.local/bin; this Mac has it in /usr/local/bin. Resolve it once --
# `command -v d` cannot be used because `d` is the function below.
# ==============================================================================
RECENTDIRS_BIN=""
for __d in "$HOME/.local/bin/d" /usr/local/bin/d; do
    if [ -x "$__d" ]; then
        RECENTDIRS_BIN="$__d"
        break
    fi
done
unset __d

if [ -n "$RECENTDIRS_BIN" ]; then
    autoload -Uz add-zsh-hook
    _recentdirs_record() { "$RECENTDIRS_BIN" add "$PWD" 2>/dev/null; }
    add-zsh-hook chpwd _recentdirs_record
    _recentdirs_record   # seed the starting directory

    # Bare `d` fuzzy-picks a recent directory and cd's into it; with args,
    # passes through to the binary (d list, d prune, ...).
    d() {
        if (($#)); then
            "$RECENTDIRS_BIN" "$@"
        else
            local dir
            dir=$("$RECENTDIRS_BIN" pick) && cd "$dir"
        fi
    }
fi

# ==============================================================================
# Secrets
# ==============================================================================
[ -f ~/.secrets ] && source ~/.secrets

# ==============================================================================
# SDKMAN  (guarded; not deployed by this repo. Must stay near last.)
# ==============================================================================
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# ==============================================================================
# Prompt: Starship. Must be last so it owns PROMPT/RPROMPT after OMZ and every
# other hook is set up. Config: ~/.config/starship.toml (deployed by
# roles/starship/). No-op if the starship binary is not installed.
# ==============================================================================
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
